# Copy to .env and adjust. All values are optional - the app runs with defaults.

# --- Security
# SECRET_KEY=  (leave unset to auto-generate a random key in storage/.secret_key)

# --- Storage (SQLite by default; PostgreSQL in docker-compose)
# DATABASE_URL=postgresql+psycopg2://codeguardian:codeguardian@localhost:5432/codeguardian
# REDIS_URL=redis://localhost:6379/0

# --- Uploads (also editable in Settings). node_modules, venv, .git and build folders inside a ZIP are skipped.
MAX_UPLOAD_MB=500
# MAX_EXTRACT_MB=4000   # safety cap on total unpacked size (zip-bomb protection)

# --- AI Reviewer / AI Remediation agents (LLM). Leave LLM_PROVIDER=none to run rule-based only.
# Free options: Groq (https://console.groq.com) or Google Gemini (https://aistudio.google.com), or local Ollama.
LLM_PROVIDER=none
# OpenAI:      LLM_PROVIDER=openai  LLM_BASE_URL=https://api.openai.com/v1                              LLM_MODEL=gpt-4o-mini
# Groq:        LLM_PROVIDER=openai  LLM_BASE_URL=https://api.groq.com/openai/v1                         LLM_MODEL=llama-3.3-70b-versatile
# Gemini:      LLM_PROVIDER=openai  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai LLM_MODEL=gemini-2.0-flash
# Ollama:      LLM_PROVIDER=openai  LLM_BASE_URL=http://localhost:11434/v1                              LLM_MODEL=qwen2.5-coder:7b
# Anthropic:   LLM_PROVIDER=anthropic                                                                    LLM_MODEL=<a Claude model id>
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_FINDINGS=25

# --- GitHub (needed for private repos / higher API rate limits)
GITHUB_TOKEN=

# --- Dependency agent: query OSV.dev for CVEs and registries for licenses
OSV_ENABLED=true

# --- Quality gate defaults
GATE_FAIL_ON=high
GATE_MIN_SECURITY_SCORE=0

# --- Optional Slack/Discord/Teams webhook for scan notifications
NOTIFY_WEBHOOK_URL=

# --- Optional Semgrep ruleset (requires `pip install semgrep`), e.g. p/owasp-top-ten
SEMGREP_CONFIG=
